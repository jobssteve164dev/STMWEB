PORT=8080
DATABASE_URL=postgresql://stmweb:change-me@127.0.0.1:5432/stmweb
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:8080
# 新登录统一由 SZLKPassport 提供；以下两项只用于迁移期保留既有管理员数据。
# STMWEB_ADMIN_USERNAME=admin
# STMWEB_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
SZLK_PASSPORT_URL=https://passport.szlk.ai
SZLK_PASSPORT_SECRET=replace-with-product-secret
PASSPORT_PRODUCT=stmweb
SZLKLAWS_BASE_URL=https://laws.szlk.ai
STMWEB_BUILD_IMAGE=stmweb/compiler:v0.1.0
# STMWEB_BUILD_IMAGE_ID=sha256:由-GitOps-Agent-安装后回填的64位摘要
# CLOUDMCP_BRIDGE_CLIENT_ID=cloudmcp-main
# CLOUDMCP_BRIDGE_CLIENT_SECRET=至少32位随机密钥
# CLOUDMCP_BRIDGE_CLIENT_SECRET_NEXT=轮换期间的下一把密钥
STMWEB_CLOUDMCP_SOURCE_REPOSITORIES=jobssteve164dev/STMWEB
