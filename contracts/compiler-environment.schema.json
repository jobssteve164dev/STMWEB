{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STMWEB compiler environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "sourceRevision", "platform", "artifact", "image", "imageId", "minimum"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "platform": { "const": "linux/amd64" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "sha256"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "image": { "type": "string", "pattern": "^stmweb/compiler:v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "imageId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "minimum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuCores", "memoryMb", "diskFreeMb"],
      "properties": {
        "cpuCores": { "type": "integer", "minimum": 1 },
        "memoryMb": { "type": "integer", "minimum": 1024 },
        "diskFreeMb": { "type": "integer", "minimum": 2048 }
      }
    }
  }
}
